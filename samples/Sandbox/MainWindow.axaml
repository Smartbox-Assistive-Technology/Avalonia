<Window xmlns="https://github.com/avaloniaui"
        xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'
        x:Class="Sandbox.MainWindow">
  <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock FontSize="24" FontFamily="Arial Rounded MT">Hello, with Arial Rounded MT</TextBlock>
    <TextBlock FontSize="24" FontFamily="Arial Rounded MT Bold" Margin="0,20,0,0">Hello, with Arial Rounded MT Bold</TextBlock>
  </StackPanel>
</Window>
